{
  "manifest_version": 3,
  "name": "Ad Shield",
  "short_name": "Ad Shield",
  "version": "1.1.5",
  "description": "Blocks ads, trackers, tracking cookies and cookie banners on all sites, and video ads on Twitch. EasyList-based. No telemetry, no remote config.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Ad Shield",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "exclude_matches": [
        "https://clips.twitch.tv/*"
      ],
      "js": [
        "build/main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "exclude_matches": [
        "https://clips.twitch.tv/*"
      ],
      "js": [
        "build/isolated-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "client_ads",
        "enabled": true,
        "path": "rules/client_ads.json"
      },
      {
        "id": "trackers",
        "enabled": false,
        "path": "rules/trackers.json"
      },
      {
        "id": "ads_1",
        "enabled": true,
        "path": "rules/ads_1.json"
      },
      {
        "id": "ads_curated",
        "enabled": true,
        "path": "rules/ads_curated.json"
      },
      {
        "id": "privacy_1",
        "enabled": true,
        "path": "rules/privacy_1.json"
      },
      {
        "id": "privacy_curated",
        "enabled": true,
        "path": "rules/privacy_curated.json"
      },
      {
        "id": "cookies_1",
        "enabled": true,
        "path": "rules/cookies_1.json"
      },
      {
        "id": "cookie_strip",
        "enabled": true,
        "path": "rules/cookie_strip.json"
      },
      {
        "id": "youtube",
        "enabled": true,
        "path": "rules/youtube.json"
      },
      {
        "id": "removeparam",
        "enabled": true,
        "path": "rules/removeparam.json"
      }
    ]
  }
}
