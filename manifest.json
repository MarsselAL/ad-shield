{
  "manifest_version": 3,
  "name": "AdBrake – Ad Blocker",
  "short_name": "AdBrake",
  "version": "2.0.3",
  "description": "Free, open-source ad, tracker, cookie-banner and video-ad blocker. No telemetry, no remote config.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "AdBrake",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "exclude_matches": [
        "https://clips.twitch.tv/*"
      ],
      "js": [
        "build/main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "exclude_matches": [
        "https://clips.twitch.tv/*"
      ],
      "js": [
        "build/isolated-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/surrogates/adsbygoogle.js",
        "src/surrogates/analytics.js",
        "src/surrogates/ga.js",
        "src/surrogates/gpt.js",
        "src/surrogates/gtm.js",
        "src/surrogates/ima3.js",
        "src/surrogates/noop.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "client_ads",
        "enabled": true,
        "path": "rules/client_ads.json"
      },
      {
        "id": "trackers",
        "enabled": false,
        "path": "rules/trackers.json"
      },
      {
        "id": "ads_1",
        "enabled": true,
        "path": "rules/ads_1.json"
      },
      {
        "id": "ads_curated",
        "enabled": true,
        "path": "rules/ads_curated.json"
      },
      {
        "id": "privacy_1",
        "enabled": true,
        "path": "rules/privacy_1.json"
      },
      {
        "id": "privacy_curated",
        "enabled": true,
        "path": "rules/privacy_curated.json"
      },
      {
        "id": "cookies_1",
        "enabled": true,
        "path": "rules/cookies_1.json"
      },
      {
        "id": "cookie_strip",
        "enabled": true,
        "path": "rules/cookie_strip.json"
      },
      {
        "id": "youtube",
        "enabled": true,
        "path": "rules/youtube.json"
      },
      {
        "id": "removeparam",
        "enabled": true,
        "path": "rules/removeparam.json"
      },
      {
        "id": "gpc",
        "enabled": true,
        "path": "rules/gpc.json"
      },
      {
        "id": "ads_surrogates",
        "enabled": true,
        "path": "rules/ads_surrogates.json"
      },
      {
        "id": "privacy_surrogates",
        "enabled": true,
        "path": "rules/privacy_surrogates.json"
      },
      {
        "id": "unwrap",
        "enabled": true,
        "path": "rules/unwrap.json"
      }
    ]
  }
}
